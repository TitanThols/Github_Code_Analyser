{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "GithubApi": {
    "Token": ""
  },
  "Hangfire": {
    "Enabled": true,
    "WorkerCount": 4
  },
  "ApiDocs": {
    "Enabled": true
  },
  "Auth": {
    "CrossSiteCookies": false
  }
}
