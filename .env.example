# Optional but recommended: a GitHub token (no scopes needed for public repos) raises the
# API quota from 60 to 5,000 requests/hour. Manifest contents are fetched from
# raw.githubusercontent.com and never count against the quota.
GITHUB_TOKEN=

# docker compose settings
APP_PORT=8080
POSTGRES_DB=depscan
POSTGRES_USER=depscan
POSTGRES_PASSWORD=depscan
POSTGRES_PORT=5433
REDIS_PORT=6380
